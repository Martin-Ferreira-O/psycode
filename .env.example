# Copiar a .env. No usar estos valores para un despliegue público.
DJANGO_DEBUG=true
# En desarrollo se genera una clave persistente en .local/ si se deja vacía.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FRONTEND_ORIGIN=http://localhost:5173
SQLITE_PATH=.local/db.sqlite3

# Desarrollo: archivos privados locales, sin enviar correo real.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=.local/emails
DEFAULT_FROM_EMAIL=psycode@example.test
# Para SMTP: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Pendientes de SCRUM-32 / SCRUM-41. No se conectan en SCRUM-31.
MONGODB_URI=
MONGODB_DATABASE=psycode
TEAMS_WORKFLOW_URL=
NOTIFICATION_EMAIL_TO=
NOTIFICATIONS_ENABLED=false
