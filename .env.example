# Copiar a .env. No usar estos valores para un despliegue público.
DJANGO_DEBUG=true
# En desarrollo se genera una clave persistente en .local/ si se deja vacía.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_PATH=/password-reset/confirm
SQLITE_PATH=.local/db.sqlite3

# Desarrollo: archivos privados locales, sin enviar correo real.
EMAIL_BACKEND=file
# Solo se usa para escribir correos cuando EMAIL_BACKEND=file.
EMAIL_FILE_PATH=.local/emails
EMAIL_FROM=no-reply@psycode.local
EMAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
# Para pruebas SMTP: EMAIL_BACKEND=smtp y credenciales solo en secretos del entorno.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# MongoDB (SCRUM-32). No se abre conexión al arrancar Django; falla al usarla si no hay servidor.
# Local: docker run --name psycode-mongo -p 27017:27017 -d mongo:7
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=psycode

# Notificaciones: el módulo lee estas variables al construir sus clientes/servicio.
# Actualmente no está conectado al flujo de registro de alertas.
TEAMS_WORKFLOW_URL=
NOTIFICATION_EMAIL_TO=
NOTIFICATIONS_ENABLED=false
TEAMS_TIMEOUT_SECONDS=10

# Análisis interno: Speechmatics Batch + JEV. Deshabilitado por defecto.
# Se leen al construir analysis_worker(); runserver no inicia ese trabajador.
# Las pruebas usan dobles HTTP: no requieren claves ni habilitar este interruptor.
# Para uso real autorizado, habilitar con 1 y proporcionar claves solo en el entorno privado.
PSYCODE_EXTERNAL_PROCESSING_ENABLED=0
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu1
SPEECHMATICS_MODEL=enhanced
SPEECHMATICS_POLL_INTERVAL=2
PSYCODE_PROVIDER_TIMEOUT=300
# auto prefiere Typesafe si existen ambas claves; no cambia de cuenta ante fallos.
JEV_PROVIDER=auto
TYPESAFE_API_KEY=
# Solo se utiliza como modelo al elegir Typesafe.
JEV_MODEL=jev-1.13.0
OPENROUTER_API_KEY=
# Solo se utiliza como modelo al elegir OpenRouter.
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
# Lista JSON de nombres/direcciones conocidos que deben redactarse antes de JEV.
# Este filtro no garantiza anonimización completa.
PSYCODE_REDACT_TERMS=[]
