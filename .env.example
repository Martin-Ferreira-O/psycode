# Copiar a .env. No usar estos valores para un despliegue público.
DJANGO_DEBUG=true
# En desarrollo se genera una clave persistente en .local/ si se deja vacía.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FRONTEND_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_PATH=/password-reset/confirm
SQLITE_PATH=.local/db.sqlite3
# Ejecutar collectstatic antes de usar ASGI; Nginx sirve únicamente esta ruta.
STATIC_ROOT=staticfiles

# Ingesta interna de fragmentos; sin agentes configurados se deniega todo acceso.
# JSON: {"agent-box-3":{"box":"box-3","token_sha256":"<64 hex SHA-256 del token completo>"}}
# El token Agent <agent_id>.<secret> se entrega al box por un canal privado.
CAPTURE_AGENTS={}
# Boxes disponibles para registrar PCs; no depende del catálogo de Smile.
PC_REGISTRY_BOXES=["box-3","box-4","box-5","box-6","box-7"]
CAPTURE_FRAGMENT_ROOT=.local/capture-fragments
CAPTURE_FRAGMENT_MAX_BYTES=26214400
CAPTURE_ORPHAN_MAX_AGE_SECONDS=3600

# Desarrollo: archivos privados locales, sin enviar correo real.
EMAIL_BACKEND=file
# Solo se usa para escribir correos cuando EMAIL_BACKEND=file.
EMAIL_FILE_PATH=.local/emails
EMAIL_FROM=no-reply@psycode.local
EMAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
# Límites compartidos en SQL: no desactivar en producción. También cuentan éxitos.
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REFRESH_IP_LIMIT=120
AUTH_RESET_IP_LIMIT=20
AUTH_OTHER_WINDOW_SECONDS=900
# Para pruebas SMTP: EMAIL_BACKEND=smtp y credenciales solo en secretos del entorno.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# MongoDB (SCRUM-32). No se abre conexión al arrancar Django; falla al usarla si no hay servidor.
# Local: docker run --name psycode-mongo -p 27017:27017 -d mongo:7
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=psycode

# Notificaciones: el módulo lee estas variables al construir sus clientes/servicio.
# El registro de alertas usa correo solo con NOTIFICATIONS_ENABLED=true.
# Teams deshabilitado; webhook pendiente de decisión.
TEAMS_WORKFLOW_URL=
# Legado: el envío principal usa configuración operativa, no esta variable.
NOTIFICATION_EMAIL_TO=
# Legado: el flujo principal actual no ejecuta respaldo.
NOTIFICATION_EMAIL_BACKUP_TO=
NOTIFICATIONS_ENABLED=false
TEAMS_TIMEOUT_SECONDS=10

# Análisis interno: Speechmatics Batch + JEV. Deshabilitado por defecto.
# Se leen al construir analysis_worker(); runserver no inicia ese trabajador.
# Las pruebas usan dobles HTTP: no requieren claves ni habilitar este interruptor.
# Para uso real autorizado, habilitar con 1 y proporcionar claves solo en el entorno privado.
PSYCODE_EXTERNAL_PROCESSING_ENABLED=0
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu1
SPEECHMATICS_MODEL=enhanced
SPEECHMATICS_POLL_INTERVAL=2
PSYCODE_PROVIDER_TIMEOUT=300
# auto prefiere Typesafe si existen ambas claves; no cambia de cuenta ante fallos.
JEV_PROVIDER=auto
TYPESAFE_API_KEY=
# Solo se utiliza como modelo al elegir Typesafe.
JEV_MODEL=jev-1.13.0
OPENROUTER_API_KEY=
# Solo se utiliza como modelo al elegir OpenRouter.
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
# Lista JSON de nombres/direcciones conocidos que deben redactarse antes de JEV.
# Este filtro no garantiza anonimización completa.
PSYCODE_REDACT_TERMS=[]

# Procesos centrales y control WS; configuración OBS/RTSP solo en psycode-agent.
CAPTURE_COORDINATOR_INTERVAL_SECONDS=5
CAPTURE_COMMAND_INTERVAL_SECONDS=1
CAPTURE_HEARTBEAT_SECONDS=30
CAPTURE_START_TIMEOUT_SECONDS=120
CAPTURE_INACTIVITY_TIMEOUT_SECONDS=90
CAPTURE_FINALIZATION_TIMEOUT_SECONDS=300
# Después de este plazo, un operador habilita recepción adicional; no se borra audio.
CAPTURE_RECEPTION_GRACE_SECONDS=604800
# Colector designado y boxes según el alcance del reporte institucional.
CAPTURE_AGENDA_SOURCES={}

# Conservación fija (no editable desde la web): 24 h de audio; recuperación 7 días.
# Fuera de DEBUG el cifrado es obligatorio; no deshabilitarlo para producción.
# SENSITIVE_STORAGE_ENCRYPTION_REQUIRED=true
ANALYSIS_STATE_ROOT=.local/analysis
# Raíces adicionales cifradas (MongoDB y respaldos). Rutas absolutas en JSON.
SENSITIVE_STORAGE_EXTRA_ROOTS=[]
# Claves provisionadas fuera de checkout/datos; solo rutas, nunca bytes de claves.
SENSITIVE_STORAGE_KEY_FILES=[]
