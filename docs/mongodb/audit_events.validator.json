{
  "collection": "audit_events",
  "validationLevel": "strict",
  "validationAction": "error",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "event_id",
        "timestamp",
        "action",
        "outcome",
        "actor_id",
        "alerta_id",
        "channel",
        "contingencia",
        "motivo",
        "error_code",
        "duration_ms",
        "intentos",
        "actor",
        "sesion_id",
        "sequence"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "objectId"
        },
        "event_id": {
          "bsonType": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Identificador del evento de bitácora. Distinto de alerta_id."
        },
        "timestamp": {
          "bsonType": "date",
          "description": "Instante UTC en que el backend registró el evento."
        },
        "action": {
          "enum": [
            "alerts.register",
            "alerts.evaluate",
            "notifications.send",
            "analysis.speechmatics",
            "analysis.jev",
            "alerts.flow",
            "notifications.result"
          ],
          "description": "Eventos internos de alertas, notificación y fallos técnicos de análisis. Autenticación solo en log."
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "skipped"
          ]
        },
        "actor_id": {
          "description": "UUID del profesional autenticado. null en registro interno o envío automático. Nunca correo ni nombre.",
          "oneOf": [
            {
              "bsonType": "null"
            },
            {
              "bsonType": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          ]
        },
        "alerta_id": {
          "bsonType": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "UUID de alerta; null para eventos técnicos sin alerta persistida."
        },
        "channel": {
          "enum": [
            "teams",
            "email",
            null
          ],
          "description": "Canal del intento, aceptado o fallido; null fuera de envíos."
        },
        "contingencia": {
          "bsonType": [
            "bool",
            "null"
          ],
          "description": "true si se usa el correo de respaldo."
        },
        "motivo": {
          "enum": [
            "sin_riesgo",
            "deshabilitada",
            "ningun_canal_acepto",
            null
          ]
        },
        "error_code": {
          "description": "Código estable. Nunca el cuerpo libre de error del proveedor ni secretos.",
          "oneOf": [
            {
              "bsonType": "null"
            },
            {
              "bsonType": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,78}$"
            }
          ]
        },
        "duration_ms": {
          "description": "Duración de este intento en milisegundos; null fuera de envíos.",
          "oneOf": [
            {
              "bsonType": "null"
            },
            {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 0
            }
          ]
        },
        "intentos": {
          "bsonType": "array",
          "description": "Campo histórico. Los eventos nuevos registran un intento por evento y dejan este arreglo vacío.",
          "items": {
            "bsonType": "object",
            "required": [
              "canal",
              "resultado",
              "error_code",
              "duracion_ms"
            ],
            "additionalProperties": false,
            "properties": {
              "canal": {
                "enum": [
                  "teams",
                  "email"
                ]
              },
              "resultado": {
                "enum": [
                  "aceptado",
                  "fallido"
                ]
              },
              "error_code": {
                "oneOf": [
                  {
                    "bsonType": "null"
                  },
                  {
                    "bsonType": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{1,78}$"
                  }
                ]
              },
              "duracion_ms": {
                "bsonType": [
                  "int",
                  "long"
                ],
                "minimum": 0
              }
            }
          }
        },
        "actor": {
          "enum": [
            "Sistema",
            "Usuario"
          ]
        },
        "sesion_id": {
          "bsonType": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "UUID de sesión para correlación cuando esté disponible."
        },
        "sequence": {
          "bsonType": [
            "int",
            "long",
            "null"
          ],
          "minimum": 0
        },
        "notification": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "mode",
            "phase",
            "reason"
          ],
          "description": "Metadatos de notificación; ausentes en eventos históricos. Sin direcciones ni texto libre.",
          "properties": {
            "id": {
              "bsonType": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "mode": {
              "enum": [
                "lista_distribucion",
                "supervisores_activos",
                null
              ]
            },
            "phase": {
              "enum": [
                "principal",
                "respaldo",
                "resumen"
              ]
            },
            "reason": {
              "enum": [
                "FALLO_PARCIAL",
                "FALLO_TOTAL",
                "SIN_DESTINATARIOS_VALIDOS",
                null
              ]
            },
            "attempt": {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 1
            },
            "status": {
              "enum": [
                "EXITO_TOTAL",
                "FALLO_PARCIAL",
                "FALLO_TOTAL",
                "SIN_DESTINATARIOS_VALIDOS"
              ]
            },
            "primary_successes": {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 0
            },
            "primary_failures": {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 0
            },
            "backup_successes": {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 0
            },
            "backup_failures": {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 0
            }
          },
          "oneOf": [
            {
              "properties": {
                "phase": {
                  "enum": [
                    "principal",
                    "respaldo"
                  ]
                }
              },
              "required": [
                "attempt"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "status"
                    ]
                  },
                  {
                    "required": [
                      "primary_successes"
                    ]
                  },
                  {
                    "required": [
                      "primary_failures"
                    ]
                  },
                  {
                    "required": [
                      "backup_successes"
                    ]
                  },
                  {
                    "required": [
                      "backup_failures"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "phase": {
                  "enum": [
                    "resumen"
                  ]
                }
              },
              "required": [
                "status",
                "primary_successes",
                "primary_failures",
                "backup_successes",
                "backup_failures"
              ],
              "not": {
                "required": [
                  "attempt"
                ]
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "actor": {
                  "enum": [
                    "Sistema"
                  ]
                },
                "actor_id": {
                  "bsonType": "null"
                }
              }
            },
            {
              "properties": {
                "actor": {
                  "enum": [
                    "Usuario"
                  ]
                },
                "actor_id": {
                  "bsonType": "string"
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "action": {
                  "enum": [
                    "alerts.register",
                    "alerts.evaluate",
                    "notifications.send",
                    "notifications.result"
                  ]
                },
                "alerta_id": {
                  "bsonType": "string"
                }
              }
            },
            {
              "properties": {
                "action": {
                  "enum": [
                    "analysis.speechmatics",
                    "analysis.jev",
                    "alerts.flow"
                  ]
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "action": {
                  "enum": [
                    "notifications.result"
                  ]
                },
                "notification": {
                  "properties": {
                    "phase": {
                      "enum": [
                        "resumen"
                      ]
                    }
                  }
                }
              },
              "required": [
                "notification"
              ]
            },
            {
              "properties": {
                "action": {
                  "enum": [
                    "notifications.send"
                  ]
                },
                "notification": {
                  "properties": {
                    "phase": {
                      "enum": [
                        "principal",
                        "respaldo"
                      ]
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "action": {
                  "enum": [
                    "alerts.register",
                    "alerts.evaluate",
                    "analysis.speechmatics",
                    "analysis.jev",
                    "alerts.flow"
                  ]
                }
              },
              "not": {
                "required": [
                  "notification"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
