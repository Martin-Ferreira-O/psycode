{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Perfil central del colector Smile v1 (campo data de respuesta)",
  "oneOf": [
    {"type": "null"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "source", "url", "interval", "timeout", "request_timeout", "format", "timezone"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0},
        "source": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://[^/?#@]+/[^?#]*index\\.php/$", "maxLength": 2048},
        "interval": {"type": "integer", "minimum": 1, "maximum": 86400},
        "timeout": {"type": "integer", "minimum": 1, "maximum": 3600},
        "request_timeout": {"type": "integer", "minimum": 1, "maximum": 300},
        "format": {"enum": ["smile.json.v1", "smile.excel.v1"]},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  ]
}
