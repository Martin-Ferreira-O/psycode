{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entrega privada de credenciales Smile v1 (campo data)",
  "description": "GET HTTPS /api/v2/internal/smile-credentials con Authorization: Agent. Solo colector vigente; null elimina el secreto local. Cache-Control: no-store. Confirmación de vinculación anuncia smile_credentials_version=1.",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "source",
        "url",
        "username",
        "password"
      ],
      "properties": {
        "version": {
          "const": "1"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+/[^?#]*index\\.php/$",
          "maxLength": 2048
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?![\\s\\S]*[\\u0000\\r\\n])(?=[\\s\\S]*\\S)[\\s\\S]+$"
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?![\\s\\S]*[\\u0000\\r\\n])(?=[\\s\\S]*\\S)[\\s\\S]+$"
        }
      }
    }
  ]
}
