{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psycode:control:1.0",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "hello",
        "ready",
        "sync",
        "state",
        "command",
        "command_ack",
        "command_receipt",
        "heartbeat",
        "heartbeat_receipt",
        "interrupted",
        "interruption_receipt",
        "status",
        "error",
        "config_sync",
        "config_received",
        "config_ack",
        "config_local",
        "config_receipt"
      ]
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "protocol_version",
    "message_id",
    "type",
    "sent_at",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "hello"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "agent_version": {
                "type": "string",
                "maxLength": 64
              },
              "capabilities": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            },
            "required": [
              "agent_version",
              "capabilities"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "box": {
                "type": "string"
              },
              "server_time": {
                "type": "string",
                "format": "date-time"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "heartbeat_interval": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "box",
              "server_time",
              "capabilities",
              "heartbeat_interval"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "sync"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "state"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "command"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "command_id": {
                "type": "string",
                "format": "uuid"
              },
              "session_id": {
                "type": "string",
                "format": "uuid"
              },
              "box": {
                "pattern": "^box-[1-9][0-9]{0,11}$"
              },
              "kind": {
                "enum": [
                  "inicio",
                  "detencion"
                ]
              },
              "scheduled_start": {
                "type": "string",
                "format": "date-time"
              },
              "scheduled_end": {
                "type": "string",
                "format": "date-time"
              },
              "audio_chunk_duration": {
                "type": "integer",
                "minimum": 10,
                "description": "Solo inicio con audio.chunk-config.v1 o v2; duración congelada por sesión."
              },
              "audio_chunk_overlap": {
                "type": "integer",
                "const": 0,
                "description": "Solo inicio con audio.chunk-config.v2 negociada. Ausente en v1/legado: solapamiento de 1 segundo."
              }
            },
            "required": [
              "command_id",
              "session_id",
              "box",
              "kind",
              "scheduled_start",
              "scheduled_end"
            ],
            "additionalProperties": false,
            "dependentRequired": {
              "audio_chunk_overlap": [
                "audio_chunk_duration"
              ]
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "audio_chunk_overlap"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "const": "inicio"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "command_ack"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "command_id": {
                "type": "string",
                "format": "uuid"
              },
              "session_id": {
                "type": "string",
                "format": "uuid"
              },
              "success": {
                "type": "boolean"
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              },
              "last_sequence": {
                "type": "integer",
                "minimum": -1
              },
              "error_code": {
                "enum": [
                  "AGENT_START_FAILED",
                  "AGENT_STOP_FAILED",
                  "AGENT_INTERRUPTED",
                  "AGENT_UNAVAILABLE",
                  "SESSION_ABANDONED",
                  "FINAL_SEQUENCE_TIMEOUT"
                ]
              }
            },
            "required": [
              "command_id",
              "session_id",
              "success",
              "occurred_at"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "command_receipt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "command_id": {
                "type": "string",
                "format": "uuid"
              },
              "session": {
                "type": "object"
              }
            },
            "required": [
              "command_id",
              "session"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "heartbeat"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "session_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "heartbeat_receipt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "session": {
                "type": "object"
              }
            },
            "required": [
              "session"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "interrupted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string",
                "format": "uuid"
              },
              "error_code": {
                "enum": [
                  "AGENT_START_FAILED",
                  "AGENT_STOP_FAILED",
                  "AGENT_INTERRUPTED",
                  "AGENT_UNAVAILABLE",
                  "SESSION_ABANDONED",
                  "FINAL_SEQUENCE_TIMEOUT"
                ]
              }
            },
            "required": [
              "session_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "interruption_receipt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "session": {
                "type": "object"
              }
            },
            "required": [
              "session"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "obs": {
                "enum": [
                  "unknown",
                  "ready",
                  "busy",
                  "unavailable"
                ]
              },
              "capturing": {
                "type": "boolean"
              },
              "pending": {
                "type": "integer",
                "minimum": 0
              },
              "free_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "remaining_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "smile_last_sync": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "operational_code": {
                "enum": [
                  "",
                  "RECOVERY_REQUIRED",
                  "DISK_LOW",
                  "STORAGE_WARNING",
                  "STORAGE_CRITICAL",
                  "UPLOAD_INTERVENTION",
                  "SMILE_UNAVAILABLE"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
              },
              "recoverable": {
                "type": "boolean"
              },
              "configuration": {
                "type": "object",
                "properties": {
                  "version": { "type": "integer", "minimum": 0, "maximum": 9223372036854775806 },
                  "local_revision": { "type": "integer", "minimum": 0, "maximum": 9223372036854775806 },
                  "effective_config": {
                    "type": "object",
                    "properties": {
                      "heartbeat_interval": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "additionalProperties": false
                  },
                  "source": { "enum": ["local", "remote", null] }
                },
                "required": ["version", "local_revision", "effective_config", "source"],
                "additionalProperties": false
              }
            },
            "required": [
              "code",
              "recoverable"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "config_sync"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "config_id": {
                "type": "string",
                "format": "uuid"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775806
              },
              "desired_config": {
                "type": "object",
                "properties": {
                  "heartbeat_interval": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "additionalProperties": false,
                "description": "Control individual. El audio se configura globalmente y viaja en la orden de sesión."
              },
              "base_local_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775806
              }
            },
            "required": [
              "config_id",
              "version",
              "desired_config",
              "base_local_revision"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "config_received"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "config_id": {
                "type": "string",
                "format": "uuid"
              },
              "box": {
                "type": "string",
                "pattern": "^box-[1-9][0-9]{0,11}$"
              }
            },
            "required": [
              "config_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "config_ack"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "config_id": {
                "type": "string",
                "format": "uuid"
              },
              "success": {
                "type": "boolean"
              },
              "state": {
                "enum": [
                  "recibido",
                  "received"
                ]
              },
              "effective_config": {
                "type": "object",
                "properties": {
                  "heartbeat_interval": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "audio_chunk_duration": {
                    "type": "integer",
                    "minimum": 10,
                    "deprecated": true,
                    "description": "Informe legado ignorado; no define audio por PC."
                  },
                  "audio_chunk_overlap": {
                    "type": "integer",
                    "minimum": 0,
                    "deprecated": true,
                    "description": "Informe legado ignorado; se negocia por sesión."
                  }
                },
                "additionalProperties": false,
                "description": "Control individual. El audio se configura globalmente y viaja en la orden de sesión."
              },
              "error_code": {
                "enum": [
                  "",
                  "CONFIG_APPLY_FAILED",
                  "CONFIG_VERSION_CONFLICT",
                  "CONFIG_RECOVERY_FAILED",
                  "INVALID_EFFECTIVE_CONFIG",
                  "MISSING_EFFECTIVE_CONFIG"
                ]
              },
              "local_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775806
              },
              "box": {
                "type": "string",
                "pattern": "^box-[1-9][0-9]{0,11}$"
              }
            },
            "required": [
              "config_id"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "success"
                ],
                "not": {
                  "required": [
                    "state"
                  ]
                }
              },
              {
                "required": [
                  "state"
                ],
                "not": {
                  "required": [
                    "success"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "config_local"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "base_version": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775806
              },
              "local_revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775806
              },
              "effective_config": {
                "type": "object",
                "properties": {
                  "heartbeat_interval": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "audio_chunk_duration": {
                    "type": "integer",
                    "minimum": 10,
                    "deprecated": true,
                    "description": "Informe legado ignorado; no define audio por PC."
                  },
                  "audio_chunk_overlap": {
                    "type": "integer",
                    "minimum": 0,
                    "deprecated": true,
                    "description": "Informe legado ignorado; se negocia por sesión."
                  }
                },
                "additionalProperties": false,
                "description": "Control individual. El audio se configura globalmente y viaja en la orden de sesión.",
                "required": [
                  "heartbeat_interval"
                ]
              }
            },
            "required": [
              "base_version",
              "local_revision",
              "effective_config"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "config_receipt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "config_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "state": {
                    "enum": [
                      "pendiente",
                      "recibido",
                      "aplicado",
                      "fallido"
                    ]
                  }
                },
                "required": [
                  "config_id",
                  "state"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775806
                  },
                  "local_revision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775806
                  }
                },
                "required": [
                  "version",
                  "local_revision"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  ]
}
