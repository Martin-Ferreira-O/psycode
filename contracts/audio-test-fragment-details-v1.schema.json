{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detalle por fragmento de diagnóstico de audio v1",
  "description": "Valor opcional de data.fragments en PUT, GET y DELETE /api/v2/internal/audio-tests/<uuid>?fragment_details=1. Las muestras son relativas al inicio de la prueba. Solo incluye fragmentos aceptados, en orden de secuencia.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sequence", "start_sample", "end_sample", "status"],
    "properties": {
      "sequence": {"type": "integer", "minimum": 0},
      "start_sample": {"type": "integer", "minimum": 0, "maximum": 9599999},
      "end_sample": {"type": "integer", "minimum": 1, "maximum": 9600000},
      "status": {
        "enum": ["queued", "analyzing", "no_signal", "signal", "indeterminate", "completed", "review", "failed"]
      },
      "reason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,39}$"}
    }
  }
}
