{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psycode:smile-json:1",
  "type": "array",
  "maxItems": 100000,
  "items": {
    "type": "object",
    "required": [
      "smile_cita_id",
      "box",
      "smile_box_id",
      "fecha",
      "hora_inicio",
      "duracion_minutos",
      "estado",
      "codigo_estado"
    ],
    "properties": {
      "smile_cita_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "box": {
        "type": "integer",
        "minimum": 1,
        "maximum": 999999999999
      },
      "smile_box_id": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,11}$"
      },
      "fecha": {
        "type": "string",
        "format": "date"
      },
      "hora_inicio": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "duracion_minutos": {
        "type": "integer",
        "minimum": 0,
        "maximum": 59999
      },
      "estado": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "codigo_estado": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "additionalProperties": false
  }
}
